# Port the web dashboard runs on
PORT=3000

# GitHub Personal Access Token (classic) with "repo" scope,
# or a fine-grained token with Contents: Read & Write on the target repo.
# Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=your_personal_access_token_here

# Identity used for the git commits
GIT_USER_NAME="Your Name"
GIT_USER_EMAIL="you@example.com"

# Optional: simple password to protect the dashboard (leave blank to disable)
DASHBOARD_PASSWORD=
